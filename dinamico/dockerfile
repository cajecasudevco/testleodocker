# Alternativa a Docker Hub: mirror oficial en Amazon ECR Public
FROM public.ecr.aws/nginx/nginx:1.27-alpine

# Mensaje por defecto (puedes sobreescribirlo con -e MESSAGE="...")
ENV MESSAGE="Bienvenido dinámico"

# Limpia el default y configura nginx básico
RUN rm -f /etc/nginx/conf.d/default.conf && \
    printf 'server {\n\
      listen 80;\n\
      server_name _;\n\
      location / {\n\
        root   /usr/share/nginx/html;\n\
        index  index.html;\n\
      }\n\
    }\n' > /etc/nginx/conf.d/default.conf

# Plantilla HTML con placeholder __MESSAGE__
RUN mkdir -p /usr/share/nginx/html && \
    printf '<!DOCTYPE html><html><head><meta charset="utf-8"><title>Nginx</title></head><body><h1>__MESSAGE__</h1></body></html>' \
    > /usr/share/nginx/html/index.html.template

# Al arrancar: reemplaza el placeholder por el valor de $MESSAGE y ejecuta nginx
CMD ["/bin/sh", "-c", "sed 's#__MESSAGE__#'\"$MESSAGE\"'#g' /usr/share/nginx/html/index.html.template > /usr/share/nginx/html/index.html && exec nginx -g 'daemon off;'"]